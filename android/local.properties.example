## Copy to local.properties and fill in local machine paths + Maps key.
## local.properties is gitignored — never commit real keys.

sdk.dir=C:\\Android\\Sdk
flutter.sdk=C:\\flutter
flutter.buildMode=debug
flutter.versionName=1.0.0
flutter.versionCode=1

# Required for Google Map tiles in Safety Map (Maps SDK for Android).
# Enable "Maps SDK for Android" for this key in Google Cloud Console.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
